{
  "schema_version": 1,
  "owner": "one-person-lab-app",
  "purpose": "app_owned_product_profile",
  "state": "active",
  "machine_boundary": "App product defaults and user-facing session profile only; no runtime truth, provider implementation, domain truth, quality verdict, or artifact authority.",
  "app_repo": "gaofeng21cn/one-person-lab-app",
  "product": {
    "id": "one_person_lab_app",
    "display_name": "One Person Lab App",
    "primary_surface": "desktop_workbench",
    "supported_release_platforms": ["macos-arm64"],
    "positioning": "purpose_first_codex_app_wrapper",
    "primary_user_path": "chat_first_codex_cli_with_builtin_mas_mag_rca_purpose_entries"
  },
  "contract_refs": {
    "active_shell": "contracts/app-shell-adapter.json",
    "page_state": "contracts/app-page-state-matrix.json",
    "first_run": "contracts/app-first-run-test-matrix.json",
    "install_exposure": "contracts/app-install-exposure-policy.json",
    "release_channel": "contracts/app-release-channel.json",
    "gui_product": "contracts/app-gui-product-contract.json"
  },
  "default_session_profile": {
    "provider": "gflab",
    "base_url": "https://gflabtoken.cn/v1",
    "executor": "codex_cli",
    "model": "gpt-5.5",
    "reasoning_effort": "xhigh",
    "applies_after": "codex_openai_api_key_configured",
    "authority": "app_session_default_only"
  },
  "gui": {
    "authority": "app_repo_owned_product_truth",
    "implementation_carrier": "opl-aion-shell",
    "appearance": {
      "default_css_theme_id": "default-theme",
      "default_css_theme_name": "Default",
      "codex_theme_default_enabled": false
    },
    "home": {
      "primary_input_surface": "single_card",
      "nested_input_card_frames_allowed": false,
      "codex_cli_fixed_executor": true,
      "home_executor_selector_visible": false,
      "codex_model_selector_visible": true,
      "codex_model_list_visible": true,
      "codex_model_policy": "codex_cli_latest_strongest_model_selector_visible",
      "codex_model_auto_option_visible": true,
      "codex_default_model": "gpt-5.5",
      "codex_default_reasoning_effort": "xhigh",
      "codex_default_permission_mode": "full-access",
      "permission_mode_selector_visible": false,
      "conversation_backend_selector_visible": false,
      "conversation_model_selector_visible": true,
      "conversation_permission_mode_selector_visible": false,
      "codex_home_model_status_label": "GPT-5.5（超高）",
      "codex_home_model_status_label_en": "GPT-5.5 (Ultra)",
      "codex_precise_model_display_policy": "friendly_default_model_and_reasoning_visible",
      "home_layout": {
        "default_mode": "composer_first_chat_canvas",
        "first_screen_policy": "chat_first_no_dashboard_or_landing_copy",
        "composer_position": "pinned_bottom",
        "composer_primary": true,
        "workspace_selector_visible": true,
        "purpose_entries_visible": ["research", "grant", "ppt"],
        "workspace_session_rail_default_state": "collapsed",
        "right_context_inspector_default_state": "collapsed",
        "must_not_show": [
          "dashboard-first home",
          "explanatory landing page",
          "backend settings panel in composer",
          "AionUI Team nav entry",
          "AionUI Team page as ordinary App surface"
        ]
      },
      "codex_auto_model_selection": {
        "strategy": "codex_cli_auto_latest_available_frontier",
        "user_can_override_model": true,
        "user_can_restore_auto": true,
        "selection_persists_into_conversation": true,
        "frontier_model_preference_order": ["gpt-5.5", "gpt-5.4", "gpt-5.3-codex", "gpt-5.2"]
      },
      "home_purpose_entries": [
        {
          "id": "research",
          "primary_label": "科研",
          "target_assistant_id": "mas",
          "target_assistant_short_name": "MAS",
          "display_policy": "purpose_first",
          "home_entry_policy": "visible_click_to_start"
        },
        {
          "id": "grant",
          "primary_label": "基金",
          "target_assistant_id": "mag",
          "target_assistant_short_name": "MAG",
          "display_policy": "purpose_first",
          "home_entry_policy": "visible_click_to_start"
        },
        {
          "id": "ppt",
          "primary_label": "演示",
          "target_assistant_id": "rca",
          "target_assistant_short_name": "RCA",
          "display_policy": "purpose_first",
          "home_entry_policy": "visible_click_to_start"
        }
      ],
      "retired_codex_models_must_not_be_exposed": ["gpt-5.2-codex", "gpt-5.1-codex-max", "gpt-5.1-codex-mini"],
      "activity_center_policy": {
        "source": "not_rendered_on_ordinary_home",
        "authority": "app_owned_home_minimal_command_surface",
        "role": "home_runtime_activity_suppressed_to_keep_composer_first",
        "default_placement": "not_rendered_on_ordinary_home",
        "home_surface_policy": "ordinary_home_must_not_render_activity_center_or_continue_work_grid",
        "allowed_home_runtime_context": [],
        "must_not_display": [
          "expanded continue-work center",
          "needs attention / active / recent activity groups",
          "per-assistant running badges",
          "module_runtime dirty state as task",
          "domain artifact body",
          "memory body",
          "quality verdict body",
          "provider implementation details"
        ],
        "footer_quick_actions_policy": "do_not_render_feedback_star_web_icons_on_home"
      }
    },
    "ordinary_conversation": {
      "path_id": "ordinary_codex_conversation",
      "entry_source": "home_purpose_entry_or_new_conversation",
      "executor": "codex_cli",
      "composer_position": "pinned_bottom",
      "purpose_tag_visible": true,
      "assistant_route_receipt_required": true,
      "backend_selector_visible": false,
      "model_selector_visible": true,
      "permission_mode_selector_visible": false,
      "provider_selector_visible": false,
      "model_status_surface": "gui.home.codex_home_model_status_label",
      "technical_details_policy": "friendly_default_model_and_reasoning_visible"
    },
    "right_context_inspector": {
      "placement": "right",
      "default_state": "collapsed",
      "opens_on_user_request_only": true,
      "chat_canvas_remains_primary": true,
      "scope": "selected_workspace_and_conversation",
      "tabs": [
        {
          "id": "files",
          "label": "Files",
          "authority": "workspace_refs_only"
        },
        {
          "id": "capabilities",
          "label": "Capabilities",
          "authority": "app_packaged_skill_profiles"
        },
        {
          "id": "runtime",
          "label": "Routing/runtime refs",
          "authority": "opl_app_state_refs_only"
        },
        {
          "id": "memory",
          "label": "Memory refs",
          "authority": "refs_only_no_memory_body_authority"
        },
        {
          "id": "automations",
          "label": "Always-On/Automations",
          "authority": "app_state_action_refs"
        },
        {
          "id": "settings",
          "label": "Settings",
          "authority": "app_owned_settings"
        }
      ],
      "must_not_own": ["runtime truth", "domain truth", "artifact body", "memory body", "backend selection authority"]
    },
    "builtin_assistant_route_receipt_policy": {
      "scope": "home_purpose_entry_to_conversation",
      "required_for_assistants": ["mas", "mag", "rca"],
      "route_kind": "builtin_capability",
      "executor": "codex_cli",
      "source": "opl_app_home",
      "required_fields": ["route_kind", "executor", "assistant_id", "assistant_short_name", "source"],
      "must_not_depend_on_visible_backend_selection": true
    },
    "ordinary_capability_selector_policy": {
      "scope": "home_composer_and_ordinary_conversation",
      "authority": "app_owned_opl_allowlist",
      "skill_source_ref": "gui.assistant_skill_profiles.required_skills + optional_skills",
      "skill_menu_policy": "assistant_scoped_required_checked_optional_visible",
      "conversation_loaded_skill_display_policy": "filter_to_ordinary_skill_allowlist",
      "mcp_server_source_ref": "gui.ordinary_capability_selector_policy.visible_mcp_server_ids",
      "mcp_menu_policy": "empty_until_app_explicitly_whitelists_opl_mcp_servers",
      "visible_mcp_server_ids": [],
      "conversation_loaded_mcp_display_policy": "filter_to_visible_mcp_server_ids",
      "forbidden_skill_examples": ["aionui-skills", "aionui-webui-setup", "skill-creator", "cron"],
      "forbidden_mcp_policy": "do_not_surface_user_or_aionui_mcp_servers_in_ordinary_home_without_app_profile_allowlist"
    },
    "default_assistants": [
      {
        "id": "mas",
        "display_name": "Med Auto Science",
        "short_name": "MAS",
        "home_purpose_label": "科研",
        "home_entry_display_policy": "purpose_first",
        "role": "research_and_paper_agent",
        "home_entry_policy": "purpose_entry_target",
        "avatar": "MAS",
        "description_i18n": {
          "zh-CN": "推进科研任务、论文写作、审稿回复、投稿材料和研究进度管理。",
          "en-US": "Advance research tasks, manuscript writing, reviewer responses, submission packages, and study progress."
        },
        "prompts_i18n": {
          "zh-CN": ["整理当前课题的研究进度和下一步计划", "帮我推进论文写作和质量检查"],
          "en-US": ["Organize this study's progress and next plan", "Advance manuscript writing and quality checks"]
        }
      },
      {
        "id": "mag",
        "display_name": "Med Auto Grant",
        "short_name": "MAG",
        "home_purpose_label": "基金",
        "home_entry_display_policy": "purpose_first",
        "role": "grant_authoring_agent",
        "home_entry_policy": "purpose_entry_target",
        "avatar": "MAG",
        "description_i18n": {
          "zh-CN": "推进基金选题、标书结构、申请书撰写、预算说明和评审意见回应。",
          "en-US": "Advance grant topics, proposal structure, application writing, budget narratives, and reviewer responses."
        },
        "prompts_i18n": {
          "zh-CN": ["把这个基金想法整理成申请书框架", "检查这份标书还缺哪些关键材料"],
          "en-US": [
            "Turn this grant idea into an application outline",
            "Check what key materials this proposal still needs"
          ]
        }
      },
      {
        "id": "rca",
        "display_name": "RedCube AI",
        "short_name": "RCA",
        "home_purpose_label": "演示",
        "home_entry_display_policy": "purpose_first",
        "role": "presentation_and_visual_deliverable_agent",
        "home_entry_policy": "purpose_entry_target",
        "avatar": "RCA",
        "description_i18n": {
          "zh-CN": "推进 PPT、汇报、图表、视觉交付物和演示材料制作。",
          "en-US": "Advance slide decks, reports, figures, visual deliverables, and presentation materials."
        },
        "prompts_i18n": {
          "zh-CN": ["把这份材料改成汇报 PPT 大纲", "帮我设计一版更清晰的视觉交付物"],
          "en-US": ["Turn these materials into a presentation outline", "Design a clearer visual deliverable"]
        }
      }
    ],
    "assistant_skill_profiles": [
      {
        "assistant_id": "mas",
        "required_skills": ["mas"],
        "optional_skills": ["mineru-document-extractor", "officecli-docx", "officecli-xlsx"],
        "required_skill_policy": "checked_locked",
        "optional_skill_policy": "unchecked_user_selectable",
        "skill_menu_policy": "assistant_scoped_required_checked_optional_visible"
      },
      {
        "assistant_id": "mag",
        "required_skills": ["mag"],
        "optional_skills": ["officecli-docx", "officecli-xlsx", "mineru-document-extractor"],
        "required_skill_policy": "checked_locked",
        "optional_skill_policy": "unchecked_user_selectable",
        "skill_menu_policy": "assistant_scoped_required_checked_optional_visible"
      },
      {
        "assistant_id": "rca",
        "required_skills": ["rca"],
        "optional_skills": ["officecli-pptx", "ui-ux-pro-max"],
        "required_skill_policy": "checked_locked",
        "optional_skill_policy": "unchecked_user_selectable",
        "skill_menu_policy": "assistant_scoped_required_checked_optional_visible"
      }
    ],
    "non_default_assistants": [
      {
        "id": "oma",
        "display_name": "OPL Meta Agent",
        "short_name": "OMA",
        "role": "opl_agent_design_and_testing_agent",
        "home_entry_policy": "explicit_or_settings_only",
        "home_default_visible": false,
        "avatar": "OMA",
        "description_i18n": {
          "zh-CN": "设计、测试和改进 OPL Agent，梳理能力边界、合同和验证流程。",
          "en-US": "Design, test, and improve OPL Agents, including capability boundaries, contracts, and verification flows."
        },
        "prompts_i18n": {
          "zh-CN": ["帮我设计一个新的 OPL Agent", "评估这个智能体的合同和测试是否完整"],
          "en-US": ["Help me design a new OPL Agent", "Evaluate whether this agent's contract and tests are complete"]
        }
      }
    ]
  },
  "codex": {
    "default_model": "gpt-5.5",
    "default_model_description": "System Codex default model when configured",
    "default_reasoning_effort": "xhigh",
    "opl_flow_context": {
      "flow_id": "opl-flow",
      "source": "one-person-lab-app",
      "delivery": "session_scoped_preset_context",
      "user_agents_policy": "respect_user_agents_no_overwrite_detect_conflicts",
      "language_policy": "follow_ui_locale_zh_only_when_ui_zh"
    },
    "default_visible_skills": [
      "mas",
      "mag",
      "rca",
      "superpowers",
      "cron",
      "officecli",
      "officecli-docx",
      "officecli-pptx",
      "officecli-xlsx",
      "officecli-academic-paper",
      "officecli-data-dashboard",
      "officecli-financial-model",
      "officecli-pitch-deck",
      "pdf",
      "mineru-document-extractor",
      "ui-ux-pro-max"
    ],
    "skill_priority": [
      "mas",
      "mag",
      "rca",
      "superpowers",
      "cron",
      "officecli",
      "officecli-docx",
      "officecli-pptx",
      "officecli-xlsx",
      "officecli-academic-paper",
      "officecli-data-dashboard",
      "officecli-financial-model",
      "officecli-pitch-deck",
      "pdf",
      "mineru-document-extractor",
      "ui-ux-pro-max"
    ],
    "session_context_lines": [
      "## OPL App 默认会话规则",
      "",
      "你正在 One Person Lab App 的 Codex 会话中工作。App 是普通用户/开发者工作台，负责使用入口、显式激活、状态投影和共享上下文；它不是 runtime truth owner。",
      "",
      "三层产品模型：",
      "- 使用 One Person Lab：面向普通用户和开发者的工作台入口。",
      "- 管理 Foundry Agents：MAS/MAG/RCA 等领域智能体持有领域事实、质量结论、运行入口和产物 authority。",
      "- 开发 OPL Agent：OPL Framework 提供开发与运行框架、Codex-first executor 接入、显式 activation、typed queue / provider-backed stage runtime 等共享能力。",
      "",
      "默认路由：",
      "- OPL App 是 Codex CLI 驱动的内置智能体桌面 App：普通用户主路径不选择 executor，不选择 Aion CLI、Claude Code 或其他 backend。",
      "- Codex CLI 是固定执行器；模型在首页显示为自动，精确模型和推理深度只进入技术细节或已连接状态。",
      "- 科研、研究、论文、课题、数据分析、审稿、返修、投稿、投稿包、研究进度：使用 MAS。",
      "- 基金、标书、申请书：使用 MAG。",
      "- PPT、演示、视觉交付物：使用 RCA。",
      "- 通用 One Person Lab 使用、工程协作或 OPL Agent 开发：保持 Codex/OPL 默认入口。",
      "- 用户明确指定 Foundry Agent 或路线时，以用户指定为准；不要要求用户输入 @MAS/@MAG/@RCA。"
    ],
    "session_context_i18n": {
      "zh-CN": [
        "## OPL App 默认会话规则",
        "",
        "你正在 One Person Lab App 的 Codex 会话中工作。App 是普通用户/开发者工作台，负责使用入口、显式激活、状态投影和共享上下文；它不是 runtime truth owner。",
        "",
        "三层产品模型：",
        "- 使用 One Person Lab：面向普通用户和开发者的工作台入口。",
        "- 管理 Foundry Agents：MAS/MAG/RCA 等领域智能体持有领域事实、质量结论、运行入口和产物 authority。",
        "- 开发 OPL Agent：OPL Framework 提供开发与运行框架、Codex-first executor 接入、显式 activation、typed queue / provider-backed stage runtime 等共享能力。",
        "",
        "默认路由：",
        "- OPL App 是 Codex CLI 驱动的内置智能体桌面 App：普通用户主路径不选择 executor，不选择 Aion CLI、Claude Code 或其他 backend。",
        "- Codex CLI 是固定执行器；模型在首页显示为自动，精确模型和推理深度只进入技术细节或已连接状态。",
        "- 科研、研究、论文、课题、数据分析、审稿、返修、投稿、投稿包、研究进度：使用 MAS。",
        "- 基金、标书、申请书：使用 MAG。",
        "- PPT、演示、视觉交付物：使用 RCA。",
        "- 通用 One Person Lab 使用、工程协作或 OPL Agent 开发：保持 Codex/OPL 默认入口。",
        "- 用户明确指定 Foundry Agent 或路线时，以用户指定为准；不要要求用户输入 @MAS/@MAG/@RCA。"
      ],
      "en-US": [
        "## OPL App Default Session Rules",
        "",
        "You are working inside a Codex session launched from One Person Lab App. The App is the user and developer workbench for entry points, explicit activation, status projection, and shared context; it is not the runtime truth owner.",
        "",
        "Three-layer product model:",
        "- Use One Person Lab: the workbench entry point for normal users and developers.",
        "- Manage Foundry Agents: MAS, MAG, RCA, and other domain agents own domain truth, quality decisions, runtime entries, and artifact authority.",
        "- Develop OPL Agents: OPL Framework provides the development and runtime framework, Codex-first executor integration, explicit activation, typed queue / provider-backed stage runtime, and shared capabilities.",
        "",
        "Default routing:",
        "- OPL App is a Codex CLI driven desktop App for built-in agents. The normal user path does not choose an executor, Aion CLI, Claude Code, or another backend.",
        "- Codex CLI is the fixed executor. The home model is displayed as Auto; exact model and reasoning details belong only in technical details or connected state.",
        "- Use MAS for research, studies, papers, datasets, reviews, revisions, submissions, submission packages, and research progress.",
        "- Use MAG for grants, proposals, and funding applications.",
        "- Use RCA for PPT, presentations, and visual deliverables.",
        "- For general One Person Lab usage, engineering collaboration, or OPL Agent development, keep the default Codex/OPL entry.",
        "- If the user explicitly names a Foundry Agent or route, follow that request. Do not require the user to type @MAS/@MAG/@RCA."
      ]
    }
  },
  "first_run": {
    "readiness_layers": ["core"],
    "ready_to_launch_gate": {
      "id": "ready_to_launch",
      "ui_order": "before_guid",
      "required_core_items": ["workspace_root", "codex_cli", "codex_config"],
      "must_not_require": [
        "domain_modules",
        "family_runtime_provider",
        "recommended_skills",
        "native_helpers",
        "repo_sync",
        "command_line_tools_install",
        "ecosystem_module_updates"
      ]
    },
    "full_readiness_layers": [
      "core",
      "domain_modules",
      "family_runtime_provider",
      "recommended_skills",
      "native_helpers",
      "repo_sync",
      "command_line_tools_install",
      "ecosystem_module_updates"
    ],
    "deferred_blockers": [
      "domain_modules",
      "family_runtime_provider",
      "recommended_skills",
      "native_helpers",
      "repo_sync",
      "command_line_tools_install",
      "ecosystem_module_updates"
    ],
    "runtime_provider": {
      "full_readiness_provider": "temporal",
      "ready_to_launch_blocking": false
    },
    "first_conversation": {
      "gate": "acp_warmup_before_initial_send",
      "source_command": "opl system initialize --json",
      "ready_to_launch_must_be_true": true,
      "must_wait_for": ["conversation_record_ready", "acp_warmup_complete"],
      "must_not_wait_for": [
        "domain_modules",
        "family_runtime_provider",
        "recommended_skills",
        "native_helpers",
        "repo_sync",
        "command_line_tools_install",
        "ecosystem_module_updates"
      ],
      "failure_policy": "show_retryable_initial_message_error_without_losing_user_prompt"
    },
    "progress_model": {
      "source_command": "opl system initialize --json",
      "source_path": "system_initialize.setup_flow",
      "renderer_truth_policy": "render_only_no_shell_private_progress_truth",
      "required_setup_flow_fields": ["phase", "ready_to_launch", "progress", "blocking_items", "maintenance_items"],
      "required_progress_fields": [
        "ready_required_count",
        "total_required_count",
        "ready_full_readiness_count",
        "total_full_readiness_count",
        "ready_optional_count",
        "total_optional_count"
      ],
      "required_checklist_fields": [
        "item_id",
        "label",
        "status",
        "readiness_layer",
        "blocking",
        "severity",
        "next_visible_step",
        "detail_summary"
      ],
      "required_visible_elements": [
        "current initialization phase",
        "Core completed and total count",
        "Full readiness completed and total count",
        "background maintenance completed and total count",
        "blocking item list",
        "next visible step"
      ]
    },
    "core_ready_policy": {
      "full_first_install_clean_machine": {
        "missing_host_tools_allowed": ["command_line_tools", "homebrew", "node", "git"],
        "initial_runtime_source": "bundled_runtime",
        "core_ready_without_host_tools": true,
        "must_not_block_core_ready": [
          "repo_sync",
          "module_reconcile",
          "command_line_tools_install",
          "native_helpers",
          "companion_skills_install",
          "ecosystem_module_updates"
        ],
        "post_core_ready_background_policy": {
          "mode": "best_effort_non_blocking",
          "continues_after_core_ready": true,
          "managed_items": [
            "repo_sync",
            "module_reconcile",
            "command_line_tools_install",
            "native_helpers",
            "companion_skills_install",
            "ecosystem_module_updates"
          ],
          "user_confirmation_items": ["command_line_tools_install"]
        }
      },
      "standard_package": {
        "bootstrap_owner": "app_managed",
