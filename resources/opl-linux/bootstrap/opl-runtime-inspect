#!/usr/bin/env bash
set -euo pipefail

export HOME=/home/opl
export CODEX_HOME=/home/opl/.codex
export OPL_WORKSPACE_ROOT=/home/opl/code
export PATH="/home/opl/.opl/one-person-lab/bin:/home/opl/.npm-global/bin:/home/opl/.local/bin:/usr/local/bin:/usr/bin:/bin"
export OPL_CODEX_BIN=/usr/local/bin/codex

if [[ "${1:-}" != "--json" ]]; then
  printf 'runtime-inspect requires --json.\n' >&2
  exit 64
fi

identity=/etc/opl/identity.json
if [[ ! -f "$identity" ]]; then
  printf 'OPL Linux identity is missing.\n' >&2
  exit 69
fi

managed_resources=/opt/opl/carrier/current/managed-resources
managed_manifest="$managed_resources/manifest.json"
if [[ ! -f "$managed_manifest" ]]; then
  printf 'The packaged Linux managed-resources manifest is missing: %s\n' "$managed_manifest" >&2
  exit 69
fi
if ! jq -e '
  select(.schema == "opl_aioncore_managed_resources_projection.v1" and .runtimeKey == "linux-x64")
  | select(.source.schemaVersion == 2)
  | select(.source.cliNames == [])
  | select(.projection.includedCliNames == ["codex"])
  | select(.projection.excludedCliNames == ["claude"])
' "$managed_manifest" >/dev/null; then
  printf 'The packaged Linux managed-resources projection manifest is invalid.\n' >&2
  exit 65
fi
for forbidden_path in \
  cli/claude \
  acp \
  node_modules/@anthropic-ai/claude-code \
  node_modules/claude-code \
  claude; do
  if [[ -e "$managed_resources/$forbidden_path" ]]; then
    printf 'The packaged Linux managed-resources projection contains a forbidden path: %s\n' "$forbidden_path" >&2
    exit 65
  fi
done
if ! managed_node_root="$(jq -er '.node.root | select(type == "string")' "$managed_manifest")" ||
  [[ ! "$managed_node_root" =~ ^node/node-v[0-9]+\.[0-9]+\.[0-9]+-linux-x64$ ]]; then
  printf 'The packaged Linux managed Node.js root is invalid.\n' >&2
  exit 65
fi
if ! managed_node_executable="$(jq -er '.node.executable | select(type == "string" and . == "bin/node")' "$managed_manifest")"; then
  printf 'The packaged Linux managed Node.js executable contract is invalid.\n' >&2
  exit 65
fi
if ! managed_node_version="$(jq -er '.node.version | select(type == "string" and test("^[0-9]+\\.[0-9]+\\.[0-9]+$"))' "$managed_manifest")"; then
  printf 'The packaged Linux managed Node.js version contract is invalid.\n' >&2
  exit 65
fi
managed_node="$managed_resources/$managed_node_root/$managed_node_executable"
managed_node_bin="$(dirname "$managed_node")"
if [[ ! -x "$managed_node" ]]; then
  printf 'The packaged Linux managed Node.js executable is unavailable: %s\n' "$managed_node" >&2
  exit 69
fi
for command_name in npm npx; do
  command_path="$managed_node_bin/$command_name"
  if [[ ! -x "$command_path" ]]; then
    printf 'The packaged Linux managed Node.js command is unavailable: %s\n' "$command_path" >&2
    exit 69
  fi
done
actual_node_version="$("$managed_node" --version 2>/dev/null || true)"
if [[ "$actual_node_version" != "v$managed_node_version" ]]; then
  printf 'The packaged Linux managed Node.js version is invalid: expected v%s, got %s\n' \
    "$managed_node_version" "${actual_node_version:-unavailable}" >&2
  exit 65
fi
actual_npm_version="$(
  PATH="$managed_node_bin:/usr/bin:/bin" "$managed_node_bin/npm" --version 2>/dev/null || true
)"
if [[ ! "$actual_npm_version" =~ ^[0-9]+\.[0-9]+\.[0-9]+([.+-][0-9A-Za-z.-]+)?$ ]]; then
  printf 'The packaged Linux npm runtime is unavailable: %s\n' "${actual_npm_version:-no version}" >&2
  exit 65
fi
actual_npx_version="$(
  PATH="$managed_node_bin:/usr/bin:/bin" "$managed_node_bin/npx" --version 2>/dev/null || true
)"
if [[ "$actual_npx_version" != "$actual_npm_version" ]]; then
  printf 'The packaged Linux npx runtime is invalid: expected %s, got %s\n' \
    "$actual_npm_version" "${actual_npx_version:-unavailable}" >&2
  exit 65
fi

identity_codex_realpath="$(jq -er '.codex_realpath' "$identity")"
identity_codex_digest="$(jq -er '.codex_digest' "$identity")"
codex_command_path="$(command -v codex || true)"
if [[ "$codex_command_path" != "$OPL_CODEX_BIN" ]] || [[ ! -x "$codex_command_path" ]]; then
  printf 'The owner-bound Codex command is unavailable.\n' >&2
  exit 69
fi
codex_command_realpath="$(readlink -f "$codex_command_path")"
codex_command_sha256="$(sha256sum "$codex_command_realpath" | awk '{print $1}')"
if [[ "$codex_command_realpath" != "$identity_codex_realpath" ]] ||
  [[ "sha256:$codex_command_sha256" != "$identity_codex_digest" ]]; then
  printf 'The owner-bound Codex command does not match the guest identity.\n' >&2
  exit 65
fi

framework_path="$(command -v opl || true)"
if [[ -z "$framework_path" ]] || [[ ! -x "$framework_path" ]]; then
  printf 'Framework CLI is unavailable.\n' >&2
  exit 69
fi
framework_realpath="$(readlink -f "$framework_path")"
framework_sha256="$(sha256sum "$framework_realpath" | awk '{print $1}')"
bootstrap_sha256="$(
  for name in opl-runtime-control opl-runtime-exec opl-runtime-inspect; do
    printf '%s\0' "$name"
    cat "/opt/opl/bootstrap/$name"
    printf '\0'
  done | sha256sum | awk '{print $1}'
)"
active_operation_count="$(
  find /var/lib/opl/runtime-state -maxdepth 1 -type f -name '*.json' -print 2>/dev/null |
    wc -l |
    tr -d '[:space:]'
)"

jq \
  --arg framework_path "$framework_realpath" \
  --arg framework_digest "sha256:$framework_sha256" \
  --arg codex_command_path "$codex_command_path" \
  --arg codex_realpath "$codex_command_realpath" \
  --arg codex_command_digest "sha256:$codex_command_sha256" \
  --arg managed_node_version "$actual_node_version" \
  --arg managed_npm_version "$actual_npm_version" \
  --arg managed_npx_version "$actual_npx_version" \
  --arg bootstrap_sha256 "$bootstrap_sha256" \
  --arg wsl_interop "${WSL_INTEROP:-}" \
  --argjson active_operation_count "$active_operation_count" \
  '. + {
    schema: "opl_linux_runtime_inspection.v1",
    protocol_version: 1,
    bootstrap_digest: ("sha256:" + $bootstrap_sha256),
    codex_command_path: $codex_command_path,
    codex_realpath: $codex_realpath,
    codex_command_digest: $codex_command_digest,
    managed_node_version: $managed_node_version,
    managed_npm_version: $managed_npm_version,
    managed_npx_version: $managed_npx_version,
    framework_path: $framework_path,
    framework_digest: $framework_digest,
    wsl2: ($wsl_interop | length > 0),
    active_operation_count: $active_operation_count
  }' \
  "$identity"
