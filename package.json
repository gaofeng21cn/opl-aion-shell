{
  "name": "one-person-lab-app",
  "version": "1.9.25",
  "private": true,
  "description": "One Person Lab App product repository.",
  "license": "Apache-2.0",
  "scripts": {
    "postinstall": "node scripts/validate-active-shell.mjs --quick",
    "install:shell": "bun install --cwd shells/aionui --frozen-lockfile",
    "start": "bun run --cwd shells/aionui start",
    "start:multi": "bun run --cwd shells/aionui start:multi",
    "webui": "bun run --cwd shells/aionui webui",
    "package": "bun run --cwd shells/aionui package",
    "build": "bun run --cwd shells/aionui build",
    "build-mac": "bun run --cwd shells/aionui build-mac",
    "build-mac:arm64": "bun run --cwd shells/aionui build-mac:arm64",
    "build-mac:x64": "bun run --cwd shells/aionui build-mac:x64",
    "build-win": "bun run --cwd shells/aionui build-win",
    "build-deb": "bun run --cwd shells/aionui build-deb",
    "i18n:types": "bun run --cwd shells/aionui i18n:types",
    "i18n:check": "cd shells/aionui && node scripts/check-i18n.js",
    "test": "node scripts/run-active-shell-tests.mjs",
    "test:coverage": "bun run --cwd shells/aionui test:coverage",
    "test:contract": "bun run --cwd shells/aionui test:contract",
    "test:e2e": "bun run --cwd shells/aionui test:e2e",
    "test:packaged:bun": "bun run --cwd shells/aionui test:packaged:bun",
    "test:opl-first-run-vm": "bun run --cwd shells/aionui test:opl-first-run-vm",
    "test:opl-first-run-vm:tart": "bun run --cwd shells/aionui test:opl-first-run-vm:tart",
    "lint": "bun run --cwd shells/aionui lint",
    "hygiene": "bun run --cwd shells/aionui hygiene",
    "format": "bun run --cwd shells/aionui format",
    "format:check": "bun run --cwd shells/aionui format:check",
    "validate:packaged-runtime": "bun run --cwd shells/aionui validate:packaged-runtime",
    "validate:opl-package": "bun run --cwd shells/aionui validate:opl-package",
    "validate:active-shell": "node scripts/validate-active-shell.mjs",
    "prepare-release-assets": "node scripts/prepare-release-assets.mjs",
    "validate-release": "node scripts/validate-release.mjs"
  }
}
