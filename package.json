{
  "name": "one-person-lab-aion-shell",
  "version": "2.1.17",
  "description": "One Person Lab App desktop shell adapter.",
  "keywords": [],
  "license": "Apache-2.0",
  "author": {
    "name": "One Person Lab",
    "email": "support@onepersonlab.dev"
  },
  "workspaces": [
    "packages/*"
  ],
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --config packages/desktop/electron.vite.config.ts",
    "start": "electron-vite dev --config packages/desktop/electron.vite.config.ts",
    "start:multi": "cross-env AIONUI_MULTI_INSTANCE=1 electron-vite dev --config packages/desktop/electron.vite.config.ts",
    "cli": "electron-vite dev --config packages/desktop/electron.vite.config.ts",
    "webui": "tsx scripts/webui.ts",
    "webui:remote": "tsx scripts/webui.ts --remote",
    "webui:prod": "cross-env NODE_ENV=production tsx scripts/webui.ts",
    "webui:prod:remote": "cross-env NODE_ENV=production tsx scripts/webui.ts --remote",
    "resetpass": "tsx scripts/resetpass.ts",
    "package": "electron-vite build --config packages/desktop/electron.vite.config.ts",
    "make": "electron-vite build --config packages/desktop/electron.vite.config.ts",
    "dist": "node scripts/build-with-builder.js",
    "dist:mac": "node scripts/build-with-builder.js auto --mac",
    "dist:win": "node scripts/build-with-builder.js auto --win",
    "dist:linux": "node scripts/build-with-builder.js auto --linux",
    "build-mac": "node scripts/build-with-builder.js auto --mac --arm64 --x64",
    "build-win": "node scripts/build-with-builder.js auto --win",
    "build-deb": "node scripts/build-with-builder.js auto --linux",
    "build-mac:arm64": "node scripts/build-with-builder.js arm64 --mac --arm64",
    "build-mac:x64": "node scripts/build-with-builder.js x64 --mac --x64",
    "build-win:arm64": "node scripts/build-with-builder.js arm64 --win --arm64",
    "build-win:x64": "node scripts/build-with-builder.js x64 --win --x64",
    "build:windows:wsl2:validation": "node packages/desktop/src/validation/windows-wsl2/build.cjs",
    "windows:wsl2:validation": "electron ./packages/desktop/src/validation/windows-wsl2",
    "build": "node scripts/build-with-builder.js auto --mac --arm64 --x64",
    "check:upstream:aionui": "node scripts/release/aionui-upstream-currentness.mjs",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "i18n:types": "node scripts/generate-i18n-types.js",
    "validate:packaged-runtime": "node scripts/validate-packaged-runtime.js",
    "validate:opl-package": "node scripts/validate-packaged-runtime.js --scan-all",
    "compare:gui-visual-cohort": "bunx tsx scripts/compare-gui-visual-cohort.ts",
    "release:smoke:opl-first-run-vm": "node scripts/opl-first-run-vm-smoke.mjs",
    "release:smoke:opl-first-run-vm:tart": "node scripts/opl-first-run-tart-smoke.mjs",
    "test:opl-first-run-vm": "npm run release:smoke:opl-first-run-vm --",
    "test:opl-first-run-vm:tart": "npm run release:smoke:opl-first-run-vm:tart --",
    "test:release-smoke:unit": "vitest run tests/unit/opl-runtime/firstRunVmSmoke.test.ts tests/unit/opl-runtime/firstRunVmSmokeScripts.test.ts",
    "test:windows:wsl2:validation": "node --test tests/unit/windows-wsl2-validation/probe.test.cjs",
    "test": "vitest run --exclude \"tests/unit/opl-runtime/*Smoke*.test.ts\"",
    "test:full": "cross-env VITEST_INCLUDE_DOM=1 VITEST_INCLUDE_INTEGRATION=1 vitest run",
    "test:watch": "vitest",
    "test:coverage": "cross-env VITEST_INCLUDE_DOM=1 VITEST_INCLUDE_INTEGRATION=1 vitest run --coverage",
    "test:contract": "vitest run tests/contract --passWithNoTests",
    "test:dom": "cross-env VITEST_INCLUDE_DOM=1 vitest run --project dom",
    "test:integration": "cross-env VITEST_INCLUDE_INTEGRATION=1 vitest run tests/integration",
    "test:packaged:i18n": "vitest run tests/integration/i18n-packaged.test.ts",
    "bench": "vitest bench",
    "bench:db": "bun test ./tests/bench/database.bench.bun.ts",
    "bench:report": "bunx tsx scripts/run-benchmarks.ts",
    "bench:startup": "bunx tsx scripts/benchmark-startup.ts",
    "bench:full": "bunx tsx scripts/run-benchmarks.ts --startup",
    "debug:perf": "cross-env ACP_PERF=1 PERF_MONITOR=1 bun start",
    "debug:perf:report": "bunx tsx scripts/debug-performance.ts --report",
    "debug:mcp": "bunx tsx scripts/debug-mcp.ts",
    "debug:mcp:list": "bunx tsx scripts/debug-mcp.ts list",
    "debug:mcp:validate": "bunx tsx scripts/debug-mcp.ts validate",
    "debug:custom-agent": "bunx tsx scripts/debug-custom-agent.ts",
    "test:e2e": "playwright test --config playwright.config.ts",
    "prepare": "husky",
    "postinstall": "node scripts/postinstall.js",
    "test:bun": "bun test packages/desktop/src/process/services/database/drivers/*.bun.test.ts"
  },
